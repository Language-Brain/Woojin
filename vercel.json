{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "redirects": [
    {
      "source": "/:path*",
      "has": [{ "type": "host", "value": "languagebrain.vercel.app" }],
      "destination": "https://literacy-korea.com/:path*",
      "permanent": true
    },
    { "source": "/customer", "destination": "/", "permanent": true },
    { "source": "/customer/index.html", "destination": "/", "permanent": true },
    { "source": "/index.html", "destination": "/", "permanent": true },
    { "source": "/article/index.html", "destination": "/article", "permanent": true }
  ],
  "rewrites": [
    { "source": "/", "destination": "/customer/index.html" },
    { "source": "/admin", "destination": "/admin/index.html" },
    { "source": "/article", "destination": "/api/article" },
    { "source": "/sitemap.xml", "destination": "/api/sitemap" },
    { "source": "/rss.xml", "destination": "/api/rss" },
    { "source": "/papers", "destination": "/archive/index.html" },
    { "source": "/news", "destination": "/archive/news.html" },
    { "source": "/works", "destination": "/archive/works.html" },
    { "source": "/videos", "destination": "/archive/videos.html" },
    { "source": "/video", "destination": "/api/video" },
    { "source": "/search", "destination": "/search/index.html" },
    { "source": "/guides", "destination": "/guides/index.html" },
    { "source": "/guide", "destination": "/guide/index.html" },
    { "source": "/pyeongjae", "destination": "/pyeongjae/index.html" },
    { "source": "/pyeongjae-entry", "destination": "/api/pyeongjae" }
  ],
  "headers": [
    {
      "source": "/admin",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        { "key": "X-Robots-Tag", "value": "noindex, nofollow, noarchive" },
        { "key": "Cache-Control", "value": "no-store" }
      ]
    }
  ]
}
